  <script>
    document.addEventListener("DOMContentLoaded", function () {
      lucide.createIcons();
      const form = document.getElementById("activation-form");
      const input = document.getElementById("license-code");
      const success = document.querySelector('[data-template-id="activation-success"]');
      const error = document.querySelector('[data-template-id="activation-error"]');
      form.addEventListener("submit", function (event) {
        event.preventDefault();
        const code = input.value.trim().toUpperCase();
        success.hidden = true;
        error.hidden = true;
        if (/^GOLD-[A-Z0-9]{4}-[A-Z0-9]{4}$/.test(code)) {
          success.hidden = false;
          form.classList.add("is-activated");
          input.value = code;
        } else {
          error.hidden = false;
          input.focus();
        }
      });
    });
